# Reassigned 2026-09-17 from 8030 to 8040 — bff-for-app's own .env hardcodes
# CAD=http://localhost:8030, so CAD gets the 8030 slot and Visualization moved to CAD's old one
# (8040) rather than the other way round, since the BFF's CAD entry is the one already depended on
# elsewhere. See RULES.md's port-assignment note.
PORT=8040
SERVICE_NAME=neve-jewels-visualization-api
KAFKA_ENABLED=true

MERCHANDISING=http://localhost:8020

MDM=http://localhost:8010
